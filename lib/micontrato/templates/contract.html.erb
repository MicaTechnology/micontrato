<!DOCTYPE html>
<html>
<head>
  <title><%= @contract.name %> - Preview</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      max-width: 8.5in;
      margin: 0 auto;
      padding: 0.15in 0.15in;
      background: white;
      font-size: 12pt;
      line-height: 1.5;
    }

    h1 {
      text-align: center;
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .cover-section {
      margin-bottom: 20px;
    }

    .cover-section-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #000;
    }

    .cover-section-header {
      background-color: #e0e0e0;
      font-size: 11pt;
      font-weight: bold;
      padding: 8px 12px;
      border: 1px solid #000;
      text-align: left;
    }

    .cover-field-row {
      border: 1px solid #000;
    }

    .cover-field-label {
      font-weight: bold;
      font-size: 10pt;
      padding: 8px 12px;
      border: 1px solid #000;
      width: 50%;
      vertical-align: top;
    }

    .cover-field-value {
      padding: 8px 12px;
      border: 1px solid #000;
      width: 50%;
      vertical-align: top;
      white-space: pre-line;
    }

    /* A `table` field: its rows share the label cell and split the value column in two. */
    .cover-field-table-cell {
      padding: 8px 12px;
      border: 1px solid #000;
      width: 25%;
      vertical-align: middle;
      text-align: center;
      font-size: 10pt;
    }

    .clauses-section {
      margin-top: 20px;
    }

    .clause {
      margin-bottom: 15px;
      text-align: justify;
      orphans: 3;
      widows: 3;
    }

    .clause p {
      margin: 10px 0;
      orphans: 2;
      widows: 2;
    }

    .clause ul, .clause ol {
      margin: 10px 0;
      padding-left: 30px;
    }

    /* Quill list styles - Quill uses <ol> with data-list attribute for all lists */
    .clause ol {
      list-style-type: none;
      counter-reset: list-0 list-1 list-2 list-3;
    }

    .clause li {
      padding-left: 1.5em;
      position: relative;
    }

    .clause li .ql-ui {
      display: none;
    }

    .clause li[data-list="bullet"]::before {
      content: '\2022';
      position: absolute;
      left: 0;
      width: 1.5em;
      text-align: center;
    }

    .clause li[data-list="ordered"] {
      counter-increment: list-0;
    }

    .clause li[data-list="ordered"]::before {
      content: counter(list-0, decimal) '. ';
      position: absolute;
      left: 0;
      width: 1.5em;
      text-align: right;
    }

    .clause li[data-list="ordered"] ~ li[data-list="bullet"] {
      counter-reset: list-0;
    }

    /* Nested list counters */
    .clause li.ql-indent-1[data-list="ordered"] {
      counter-increment: list-1;
    }

    .clause li.ql-indent-1[data-list="ordered"]::before {
      content: counter(list-1, lower-alpha) '. ';
    }

    .clause li.ql-indent-2[data-list="ordered"] {
      counter-increment: list-2;
    }

    .clause li.ql-indent-2[data-list="ordered"]::before {
      content: counter(list-2, lower-roman) '. ';
    }

    /* Quill alignment classes */
    .ql-align-left {
      text-align: left;
    }

    .ql-align-center {
      text-align: center;
    }

    .ql-align-right {
      text-align: right;
    }

    .ql-align-justify {
      text-align: justify;
    }

    /* Quill indent classes */
    .ql-indent-1 {
      padding-left: 3em;
    }

    .ql-indent-2 {
      padding-left: 6em;
    }

    .ql-indent-3 {
      padding-left: 9em;
    }

    .ql-indent-4 {
      padding-left: 12em;
    }

    .ql-indent-5 {
      padding-left: 15em;
    }

    .ql-indent-6 {
      padding-left: 18em;
    }

    .ql-indent-7 {
      padding-left: 21em;
    }

    .ql-indent-8 {
      padding-left: 24em;
    }

    /* Table styles */
    .clause table {
      border-collapse: collapse;
      width: 100%;
      margin: 10px 0;
    }

    .clause table td,
    .clause table th {
      border: 1px solid #000;
      padding: 10px;
      vertical-align: top;
      min-width: 100px;
    }

    .clause table th {
      font-weight: bold;
      background: #f5f5f5;
    }

    .contract-info {
      text-align: center;
      font-size: 10pt;
      color: #666;
      margin-top: 50px;
      padding-top: 20px;
      border-top: 1px solid #ccc;
    }

    .watermark {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.06;
      z-index: -1;
      pointer-events: none;
    }

    .watermark img {
      width: 400px;
      height: auto;
    }

    @media print {
      body {
        padding: 0;
      }
      .contract-info {
        display: none;
      }
    }
  </style>
</head>
<body>
  <% if @watermark_image %>
    <div class="watermark">
      <img src="<%= @watermark_image %>" alt="" />
    </div>
  <% end %>

  <!-- Header Elements (rendered before cover sections) -->
  <%= render_clauses(@header_clauses).html_safe %>

  <h1><%= @contract.name %></h1>

  <!-- Cover Sections -->
  <% @cover_sections.each do |section| %>
    <div class="cover-section">
      <table class="cover-section-table">
        <thead>
          <tr>
            <th colspan="3" class="cover-section-header"><%= section.name %></th>
          </tr>
        </thead>
        <tbody>
          <% if section.cover_fields.is_a?(Array) %>
            <% section.cover_fields.each do |field| %>
              <% next unless field.is_a?(Hash) %>
              <% if table_field?(field) %>
                <% rows = table_rows(field) %>
                <% next if rows.empty? %>
                <% rows.each_with_index do |row, row_index| %>
                  <tr class="cover-field-row">
                    <% if row_index.zero? %>
                      <td class="cover-field-label" rowspan="<%= rows.size %>"><%= field['label'] %></td>
                    <% end %>
                    <td class="cover-field-table-cell"><%= row[0] %></td>
                    <td class="cover-field-table-cell"><%= row[1] %></td>
                  </tr>
                <% end %>
                <% next %>
              <% end %>
              <% field_value = evaluate_field_value(field, @mica_rent) %>
              <% next if field_hidden?(field, field_value) %>
              <tr class="cover-field-row">
                <td class="cover-field-label"><%= field['label'] %></td>
                <td class="cover-field-value" colspan="2">
                  <%= field_value %>
                  <% if field['is_editable'] && @show_admin_info %>
                    <span style="color: #999; font-size: 9pt; margin-left: 10px;">(editable)</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <!-- Clauses Section -->
  <div class="clauses-section">
    <% if @clauses.any? %>
      <%
        # Calculate ordinals for clauses with show_title: true
        visible_clauses = @clauses.select(&:show_title)
        ordinal_map = {}
        visible_clauses.each_with_index do |clause, index|
          ordinal_map[clause.id] = index + 1
        end
      %>
      <% @clauses.each_with_index do |clause, clause_index| %>
        <% is_last_clause = clause_index == @clauses.size - 1 %>
        <% if clause.clause_type == 'page_break' %>
          <% unless is_last_clause %>
            <!-- Page Break -->
            <% if @show_admin_info %>
              <div style="margin: 20px 0; display: flex; align-items: center; gap: 10px;">
                <div style="flex: 1; border-top: 2px dashed #f59e0b;"></div>
                <span style="color: #92400e; font-size: 9pt; white-space: nowrap; background: #fef3c7; padding: 2px 8px; border-radius: 4px;">Salto de página</span>
                <div style="flex: 1; border-top: 2px dashed #f59e0b;"></div>
              </div>
            <% end %>
            <div style="page-break-after: always;"></div>
          <% end %>
        <% elsif clause.clause_type == 'image' %>
          <!-- Image Clause -->
          <% image_src = clause_image_src(clause) %>
          <% if image_src.present? %>
            <div style="display: table; width: 100%; height: 355.6mm; text-align: center;">
              <div style="display: table-cell; vertical-align: middle;">
                <img src="<%= image_src %>" style="max-width: 100%; height: auto;" />
              </div>
            </div>
          <% end %>
        <% elsif clause.clause_type == 'pdf_attachment' %>
          <!-- PDF Attachment Placeholder (pages will be merged post-generation) -->
          <!-- PDF_ATTACHMENT_PLACEHOLDER:<%= clause.id %> -->
          <% unless is_last_clause %>
            <div style="page-break-after: always;"></div>
          <% end %>
        <% elsif clause.clause_type == 'signature' %>
          <!-- Signature Clause -->
          <div class="clause" style="page-break-inside: avoid;">
            <% if clause.title.present? %>
              <p><%= clause.title %></p>
            <% end %>

            <%
              tenant = signature_participant(:tenant)
              landlord = signature_participant(:landlord)
              guarantor = signature_participant(:guarantor)
              show_guarantor_box = !guarantor.nil? || @contract&.for_joint_obligor
            %>

            <!-- Signature Blocks: the signer's name, email and phone print under each label,
                 like the Google-Docs contracts, so the signatories can be verified on paper. -->
            <div class="signatures-section" style="margin-top: 80px;">
              <!-- Main parties signature block -->
              <table style="width: 100%; border-collapse: collapse; margin-bottom: 40px;">
                <tr>
                  <td style="width: 50%; border: 1px solid #000; padding: 80px 20px 20px 20px; text-align: center; vertical-align: bottom;">
                    <div style="font-weight: bold; font-size: 11pt;">"FIRMA EL ARRENDATARIO"</div>
                    <% signature_participant_lines(tenant).each do |line| %>
                      <div style="font-size: 10pt; font-weight: bold;"><%= line %></div>
                    <% end %>
                  </td>
                  <td style="width: 50%; border: 1px solid #000; padding: 80px 20px 20px 20px; text-align: center; vertical-align: bottom;">
                    <div style="font-weight: bold; font-size: 11pt;">"FIRMA EL ARRENDADOR"</div>
                    <% signature_participant_lines(landlord).each do |line| %>
                      <div style="font-size: 10pt; font-weight: bold;"><%= line %></div>
                    <% end %>
                  </td>
                </tr>
              </table>

              <% if show_guarantor_box %>
                <% role_label = guarantor && !guarantor[:role].to_s.empty? ? guarantor[:role] : 'OBLIGADO SOLIDARIO' %>
                <table style="width: 60%; margin: 0 auto; border-collapse: collapse;">
                  <tr>
                    <td style="border: 1px solid #000; padding: 80px 20px 20px 20px; text-align: center; vertical-align: bottom;">
                      <div style="font-weight: bold; font-size: 11pt;">"FIRMA EL <%= role_label %>"</div>
                      <% signature_participant_lines(guarantor).each do |line| %>
                        <div style="font-size: 10pt; font-weight: bold;"><%= line %></div>
                      <% end %>
                    </td>
                  </tr>
                </table>
              <% end %>
            </div>
          </div>
        <% elsif clause.clause_type == 'landlord_and_mica_signature' %>
          <!-- Landlord and Mica Signature Clause -->
          <div class="clause" style="page-break-inside: avoid;">
            <% if clause.title.present? %>
              <p><%= clause.title %></p>
            <% end %>

            <%
              client = signature_participant(:client)
              mica = signature_participant(:mica)
            %>

            <div class="signatures-section" style="margin-top: 80px;">
              <table style="width: 100%; border-collapse: collapse;">
                <tr>
                  <td style="width: 50%; padding: 20px 40px 20px 20px; text-align: center; vertical-align: top; border: none;">
                    <div style="font-weight: bold; font-size: 11pt;">"CLIENTE"</div>
                    <div style="height: 100px;"></div>
                    <div style="border-top: 1px solid #000; margin: 0 auto; width: 85%;"></div>
                    <div style="font-weight: bold; font-size: 11pt; margin-top: 8px;">"FIRMA EL CLIENTE"</div>
                    <div style="margin-top: 25px;">
                      <% signature_participant_lines(client).each do |line| %>
                        <div style="font-size: 10pt;"><%= line %></div>
                      <% end %>
                    </div>
                    <div style="font-weight: bold; font-size: 10pt;"><%= (client && client[:subtitle]) || 'POR SU PROPIO DERECHO' %></div>
                  </td>
                  <td style="width: 50%; padding: 20px 20px 20px 40px; text-align: center; vertical-align: top; border: none;">
                    <div style="font-weight: bold; font-size: 11pt;"><%= Micontrato::Helpers::FieldHelper::MICA_SIGNATURE_LABEL %></div>
                    <div style="font-size: 10pt;"><%= (mica && mica[:company]) || Micontrato::Helpers::FieldHelper::MICA_RAZON_SOCIAL %></div>
                    <div style="height: 80px;"></div>
                    <div style="border-top: 1px solid #000; margin: 0 auto; width: 85%;"></div>
                    <div style="font-weight: bold; font-size: 11pt; margin-top: 8px;">"FIRMA MICA RENT"</div>
                    <div style="font-weight: bold; font-size: 10pt; margin-top: 25px;"><%= (mica && mica[:name]) || Micontrato::Helpers::FieldHelper::MICA_REPRESENTANTE_LEGAL %></div>
                    <div style="font-weight: bold; font-size: 10pt;">REPRESENTANTE LEGAL</div>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        <% else %>
        <div class="clause"<% if @show_admin_info %> style="position: relative; margin-bottom: 25px; border-left: 3px solid <%= clause.is_editable ? '#3b82f6' : clause.allow_comments ? '#10b981' : '#9ca3af' %>; padding-left: 15px;"<% end %>>
          <!-- Admin info indicators (only shown in preview mode) -->
          <% if @show_admin_info %>
            <div style="position: absolute; top: 0; left: calc(100% + 15px); display: flex; flex-direction: column; gap: 5px; width: 120px; font-size: 9pt;">
              <% if clause.is_editable %>
                <span style="color: #3b82f6; font-weight: bold; padding: 4px 8px; background: #dbeafe; border-radius: 4px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" title="Editable by Contract Admins">✏️ Editable</span>
              <% end %>
              <% if clause.allow_comments %>
                <span style="color: #10b981; font-weight: bold; padding: 4px 8px; background: #d1fae5; border-radius: 4px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" title="Allows Comments">💬 Commentable</span>
              <% end %>
              <% unless clause.show_title %>
                <span style="color: #ef4444; font-weight: bold; padding: 4px 8px; background: #fee2e2; border-radius: 4px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" title="Title Hidden">🚫 Hidden Title</span>
              <% end %>
              <span style="color: #6b7280; font-size: 8pt; padding: 4px 8px; background: #f3f4f6; border-radius: 4px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">Pos: <%= clause.position %></span>
            </div>
          <% end %>

          <!-- Clause content -->
          <%
            # Build the title HTML if clause should show title
            title_html = if clause.show_title && ordinal_map[clause.id]
              ordinal = spanish_ordinal(ordinal_map[clause.id])
              "<strong>#{ordinal}.- #{clause.title}.</strong> "
            else
              ""
            end

            # Inject title inline with text (inside first <p> tag if present)
            clause_content = if title_html.present?
              if clause.text.include?('<p')
                # Inject title after the first <p> opening tag
                clause.text.sub(/<p[^>]*>/i) { |match| "#{match}#{title_html}" }
              else
                # Otherwise, prepend title
                title_html + clause.text
              end
            else
              clause.text
            end
          %>
          <%= clause_content %>
        </div>
        <% end %>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 40px; background: #f9f9f9; border: 1px dashed #ccc;">
        <p style="color: #666; margin: 0;">No clauses have been added yet.</p>
      </div>
    <% end %>
  </div>

  <% if @show_admin_info %>
    <div class="contract-info">
      <p>
        Contract: <%= @contract.name %><br>
        <% if @contract.respond_to?(:company) %>
          Company: <%= @contract.company&.name || 'Global (All Companies)' %><br>
        <% end %>
        For Joint Obligor: <%= @contract.for_joint_obligor ? 'Yes' : 'No' %><br>
        Created: <%= @contract.created_at.strftime('%B %d, %Y') %>
      </p>
      <p>
        <em>This is a preview only. Actual contract values are populated from contract data.</em>
      </p>
    </div>
  <% end %>
</body>
</html>
